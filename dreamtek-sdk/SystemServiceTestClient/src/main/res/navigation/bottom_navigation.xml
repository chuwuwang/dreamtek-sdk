<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_system">

    <fragment
        android:id="@+id/navigation_system"
        android:name="com.dreamtek.systemservice.test.demo.fragment.SystemFragment"
        tools:layout="@layout/fragment_system" />


    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.dreamtek.systemservice.test.demo.fragment.SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_network"
        android:name="com.dreamtek.systemservice.test.demo.fragment.NetworkFragment"
        tools:layout="@layout/fragment_network" />

    <fragment
        android:id="@+id/navigation_deviceinfo"
        android:name="com.dreamtek.systemservice.test.demo.fragment.DeviceInfoFragment"
        tools:layout="@layout/fragment_device_info" />
</navigation>