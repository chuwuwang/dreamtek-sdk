<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/automation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/automation_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/automation_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/automation_initializing"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/automation_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@color/whitesmoke"
        android:padding="16dp"
        android:text="@string/automation_waiting"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/automation_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/automation_log_started"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
