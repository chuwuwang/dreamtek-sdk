<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".view.custompinpad.InputPinActivity"
    android:background="#FFD400">

    <include layout="@layout/layout_title"/>
    <TextView
        android:layout_width="656px"
        android:layout_height="82px"
        android:text="@string/tv_hint_enter_pin"
        android:textSize="48px"
        android:textColor="#3A3433"
        android:gravity="center"
        android:layout_marginTop="152px"
        android:layout_marginLeft="32px"/>

    <LinearLayout
        android:id="@+id/ll_passwd_list"
        android:layout_width="560px"
        android:layout_height="100px"
        android:background="@drawable/bg_input_box"
        android:layout_marginTop="378px"
        android:layout_marginLeft="80px"
        android:gravity="center">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_passwd_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <view.custompinpad.PinKeyBoardView
        android:id="@+id/keyboardview_inputpin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
